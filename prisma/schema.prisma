generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS & TEAMS ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  businessName String?
  industry     String?
  city         String?
  phone        String?
  role         String   @default("MEMBER") // ADMIN | MEMBER
  xp           Int      @default(0)
  refCode      String?  @unique // personal invite code (lazy-generated)
  platformAdmin Boolean @default(false)
  resetTokenHash  String?   // sha256 of the password-reset token (never the token itself)
  resetTokenExpiry DateTime? // single-use, 30-minute window
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamsOwned         Team[]              @relation("TeamOwner")
  memberships        TeamMember[]
  tasksCreated       Task[]              @relation("TaskCreator")
  tasksAssigned      Task[]              @relation("TaskAssignee")
  leads              Lead[]
  clients            Client[]
  financeEntries     FinanceEntry[]
  wallet             Wallet?
  creditTxs          CreditTx[]
  topUps             TopUp[]
  aiPlans            AiPlan[]
  aiChats            AiMessage[]
  xpEvents           XpEvent[]
  challengeProgress  ChallengeProgress[]
  projects           Project[]
  appointments       Appointment[]
  invoices           Invoice[]
  emailLogs          EmailLog[]
  userSettings       UserSetting[]
  subscription       Subscription?
  referralsMade      Referral[]    @relation("Referrer")
  referralsReceived  Referral[]    @relation("Invitee")
  waMessages         WaMessage[]
}

// ============ COMPANY WORKSPACE (per-business context) ============

model Project {
  id           String   @id @default(cuid())
  userId       String
  name         String
  industry     String?
  valueProp    String?
  targetMarket String?
  offerings    String? // newline-separated list of products/services
  tone         String? // communication tone for AI drafts
  website      String?
  contactEmail String?
  contactPhone String?
  salesPitch   String? // AI-generated pitch (ProfileView → /api/ai/sales-pitch)
  audienceInsight String? // AI business-URL analysis: audience, brand voice + pitch pack (JSON)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads        Lead[]
  clients      Client[]
  financeEntries FinanceEntry[]
  appointments Appointment[]
  invoices     Invoice[]
  emailLogs    EmailLog[]

  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members TeamMember[]
  tasks   Task[]
  leads   Lead[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String @default("MEMBER") // OWNER | MEMBER

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// ============ LEADS / CRM ============

model Lead {
  id          String   @id @default(cuid())
  userId      String
  teamId      String?
  company     String
  contactName String?
  email       String?
  phone       String?
  website     String?
  industry    String?
  city        String?
  country     String?
  source      String   @default("MANUAL") // EXPLEE | CSV | MANUAL
  stage       String   @default("NEW") // NEW | CONTACTED | QUALIFIED | QUOTE_SENT | WON | LOST
  value       Float    @default(0)
  notes       String?
  unlocked    Boolean  @default(false) // contact details revealed (paid)
  score       Int?
  externalId  String? // Explee dedup
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, stage])
  @@index([projectId])
}

model Client {
  id           String   @id @default(cuid())
  userId       String
  name         String
  company      String?
  email        String?
  phone        String?
  notes        String?
  monthlyValue Float    @default(0)
  status       String   @default("ACTIVE") // ACTIVE | CHURNED
  source       String   @default("MANUAL") // MANUAL | WHATSAPP | WHATSAPP_AUTO | VCF | CSV
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ============ TASKS ============

model Task {
  id         String    @id @default(cuid())
  title      String
  notes      String?
  status     String    @default("TODO") // TODO | IN_PROGRESS | DONE
  priority   String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate    DateTime?
  isPrivate  Boolean   @default(false)
  teamId     String? // null = personal task
  creatorId  String
  assigneeId String?

  creator  User  @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team     Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, status])
  @@index([teamId, status])
}

// ============ FINANCE ============

model FinanceEntry {
  id          String   @id @default(cuid())
  userId      String
  type        String // INCOME | EXPENSE
  description String
  category    String?
  amount      Float // positive rands
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([projectId])
}

// ============ APPOINTMENTS ============

model Appointment {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  title      String
  clientName String?
  notes      String?
  startsAt   DateTime
  endsAt     DateTime?
  meetLink   String? // Jitsi link (meet.ts)
  source     String    @default("MANUAL") // MANUAL | VOICE
  gcalEventId String?  // set when synced to Google Calendar
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([projectId])
}

// ============ INVOICES ============

model Invoice {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  number      String    @unique
  clientName  String
  clientEmail String?
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE
  items       String    @default("[]") // JSON [{description, quantity, unitPrice}]
  currency    String    @default("ZAR")
  subtotal    Float     @default(0)
  taxRate     Float     @default(15)
  total       Float     @default(0)
  logoUrl     String?   // data URL for the printable template
  bankDetails String?   // banking details snapshot printed on the invoice (plain text lines)
  notes       String?
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([projectId])
}

// ============ EMAIL (user's own Gmail SMTP) ============

model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  leadId    String?
  toEmail   String
  subject   String
  body      String
  status    String   @default("DRAFT") // DRAFT | SENT | FAILED
  provider  String   @default("GMAIL")
  error     String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ============ WHATSAPP (Cloud API log: inbound auto-capture + outbound sends) ============

model WaMessage {
  id          String   @id @default(cuid())
  userId      String
  clientId    String?
  phone       String   // E.164 without + (WhatsApp wa_id)
  direction   String   // IN | OUT
  body        String
  status      String   @default("RECEIVED") // RECEIVED | SENT | FAILED
  waMessageId String?  // Meta wamid for dedup/status
  error       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, phone])
}

// ============ USER INTEGRATION SETTINGS ============

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String // GMAIL_USER | GMAIL_APP_PASSWORD | GEMINI_API_KEY | EXPLEE_API_KEY ...
  value     String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ============ WALLET / CREDITS ============

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // cents (R1 = 100)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTx {
  id           String   @id @default(cuid())
  userId       String
  type         String // TOPUP | LEAD_REVEAL | BONUS | ADJUSTMENT
  amount       Int // cents, negative = spend
  description  String
  balanceAfter Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TopUp {
  id          String   @id @default(cuid())
  userId      String
  packageId   String
  amountCents Int // what user pays
  creditCents Int // credits received
  status      String   @default("PENDING") // PENDING | PAID | FAILED
  provider    String   @default("YOCO")
  reference   String
  providerRef String? // Yoco checkout/payment id for reconciliation
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ AI ============

model AiPlan {
  id        String   @id @default(cuid())
  userId    String
  answers   String // JSON of wizard answers
  content   String // markdown plan
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============ GAMIFICATION ============

model XpEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String // LEAD_ADDED | TASK_DONE | LEAD_REVEALED | DAILY_LOGIN | AI_PLAN ...
  amount      Int
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ChallengeProgress {
  id     String  @id @default(cuid())
  userId String
  day    String // YYYY-MM-DD
  key    String
  count  Int     @default(0)
  done   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, key])
}

// ============ PLATFORM CONFIG (admin) ============

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============ SUBSCRIPTIONS (predictable MRR) ============

model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique // one plan per user (upsert on renewal/upgrade)
  plan        String    // HUSTLER | BOSS
  status      String    @default("PENDING") // PENDING | ACTIVE | PAST_DUE | CANCELED
  amountCents Int
  provider    String    @default("YOCO")
  reference   String    // platform reference (HPSUB-...)
  providerRef String?   // Yoco checkout/payment id for reconciliation
  startedAt   DateTime?
  renewsAt    DateTime? // monthly anniversary; renewal nudge fires 5 days before
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, renewsAt])
}

// ============ REFERRALS (distribution + reverse churn) ============

model Referral {
  id            String    @id @default(cuid())
  referrerId    String    // who shared their code
  invitedUserId String?   // set when the invited person registers
  invitedEmail  String?
  status        String    @default("SIGNED_UP") // SIGNED_UP | SUBSCRIBED
  rewardCents   Int       @default(0) // total credited to referrer
  createdAt     DateTime  @default(now())
  subscribedAt  DateTime?

  referrer    User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  invitedUser User?  @relation("Invitee", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([invitedUserId])
}
