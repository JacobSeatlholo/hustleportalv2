generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS & TEAMS ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  businessName String?
  industry     String?
  city         String?
  phone        String?
  role         String   @default("MEMBER") // ADMIN | MEMBER
  accountStatus String  @default("ACTIVE") // ACTIVE | SUSPENDED (exec can pause an account; suspended = locked out everywhere)
  suspendedAt  DateTime?
  suspendReason String?
  xp           Int      @default(0)
  refCode      String?  @unique // personal invite code (lazy-generated)
  platformAdmin Boolean @default(false)
  resetTokenHash  String?   // sha256 of the password-reset token (never the token itself)
  resetTokenExpiry DateTime? // single-use, 30-minute window
  // Session epoch: bumped on every password reset/change. JWTs embed the epoch
  // they were issued under, so a reset instantly kills every older session —
  // a stolen cookie stops working the moment the owner reclaims the account.
  sessionEpoch Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamsOwned         Team[]              @relation("TeamOwner")
  memberships        TeamMember[]
  aiUsage            AiUsage[]
  tasksCreated       Task[]              @relation("TaskCreator")
  tasksAssigned      Task[]              @relation("TaskAssignee")
  leads              Lead[]
  clients            Client[]
  financeEntries     FinanceEntry[]
  wallet             Wallet?
  creditTxs          CreditTx[]
  topUps             TopUp[]
  aiPlans            AiPlan[]
  aiChats            AiMessage[]
  xpEvents           XpEvent[]
  challengeProgress  ChallengeProgress[]
  projects           Project[]
  appointments       Appointment[]
  invoices           Invoice[]
  emailLogs          EmailLog[]
  userSettings       UserSetting[]
  subscription       Subscription?
  referralsMade      Referral[]    @relation("Referrer")
  referralsReceived  Referral[]    @relation("Invitee")
  waMessages         WaMessage[]
  inventoryItems     InventoryItem[]
  pushSubs           PushSubscription[]
  taskComments       TaskComment[]
  projectMemberships ProjectMember[]  @relation("ProjectMemberUser")
  poolLeads          ClientPoolLead[]
  meetingsOwned      Meeting[]        @relation("MeetingOwner")
  meetingsAsMember   Meeting[]        @relation("MeetingMember")
}

// ============ FACILITATED MEETINGS (Executive Dashboard) ============
// The owner sets a business meeting between a member (or soon-to-be member)
// and an outside guest. The member confirms with one tap from the invite
// email; on confirmation both parties get the final details.

model Meeting {
  id             String    @id @default(cuid())
  ownerId        String // the exec account that set the meeting
  title          String
  memberUserId   String? // Zola's HustlePortal account, when one exists
  memberName     String
  memberEmail    String
  memberBusiness String?
  memberPhone    String?
  guestName      String?
  guestEmail     String
  startsAt       DateTime
  endsAt         DateTime?
  meetLink       String? // Jitsi link (meet.ts)
  location       String? // physical venue; when set the meeting is in person and the venue replaces the online join link everywhere
  status         String    @default("PROPOSED") // PROPOSED | CONFIRMED | DECLINED
  confirmToken   String    @unique // one tap confirm/decline from the invite email
  shareToken     String?   @unique // unguessable link both parties open: details, comments, updates (/m/<token>)
  notes          String?
  invitedAt      DateTime?
  confirmedAt    DateTime?
  emailsSentAt   DateTime? // when both parties were emailed the final details
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner    User             @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member   User?            @relation("MeetingMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  comments MeetingComment[]

  @@index([ownerId, startsAt])
  @@index([memberUserId])
  @@index([status])
}

// Comments posted from the shared meeting page (/m/<token>). Either party can
// leave a note; the owner sees them on the Executive Dashboard and new notes
// email the other side, so the conversation never stalls.
model MeetingComment {
  id         String   @id @default(cuid())
  meetingId  String
  side       String // MEMBER | GUEST
  authorName String
  body       String
  createdAt  DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

// ============ COMPANY WORKSPACE (per-business context) ============

model Project {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?  // what this project is about — the monday.com style summary
  industry     String?
  valueProp    String?
  targetMarket String?
  offerings    String? // newline-separated list of products/services
  tone         String? // communication tone for AI drafts
  website      String?
  contactEmail String?
  contactPhone String?
  salesPitch   String? // AI-generated pitch (ProfileView → /api/ai/sales-pitch)
  audienceInsight String? // AI business-URL analysis: audience, brand voice + pitch pack (JSON)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  leads        Lead[]
  clients      Client[]
  financeEntries FinanceEntry[]
  appointments Appointment[]
  invoices     Invoice[]
  emailLogs    EmailLog[]

  @@index([userId])
}

// People assigned to a project workspace (the owner's team members, per project).
// Assigning is explicit: a teammate sees the project name on tasks and pipelines
// they touch, and the owner sees exactly who is on each project.
model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  role       String   @default("MEMBER") // MEMBER | MANAGER
  addedById  String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members TeamMember[]
  tasks   Task[]
  leads   Lead[]
  invites TeamInvite[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String @default("MEMBER") // OWNER | MEMBER

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// Pending teammate invitations — emails invited before they have an account.
// When someone registers with a invited email they are attached to the team automatically.
model TeamInvite {
  id          String    @id @default(cuid())
  teamId      String
  email       String    // lowercased at creation
  role        String    @default("MEMBER")
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([email])
}

// ============ LEADS / CRM ============

model Lead {
  id          String   @id @default(cuid())
  userId      String
  teamId      String?
  company     String
  contactName String?
  role        String? // the human's part: Owner, Manager, Buyer
  profileUrl  String? // public profile page where this person is named (LinkedIn, team page, directory)
  email       String?
  phone       String?
  website     String?
  address     String? // physical address: street, suburb, city
  industry    String?
  city        String?
  country     String?
  source      String   @default("MANUAL") // EXPLEE | CSV | MANUAL
  stage       String   @default("NEW") // NEW | CONTACTED | QUALIFIED | QUOTE_SENT | WON | LOST
  value       Float    @default(0)
  notes       String?
  unlocked    Boolean  @default(false) // contact details revealed (paid)
  score       Int?
  externalId  String? // Explee dedup
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  emailLogs EmailLog[]
  tasks     Task[]

  @@index([userId, stage])
  @@index([projectId])
}

model Client {
  id           String   @id @default(cuid())
  userId       String
  name         String
  company      String?
  email        String?
  phone        String?
  notes        String?
  monthlyValue Float    @default(0)
  status       String   @default("ACTIVE") // ACTIVE | CHURNED
  source       String   @default("MANUAL") // MANUAL | WHATSAPP | WHATSAPP_AUTO | VCF | CSV
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ============ TASKS ============

model Task {
  id         String    @id @default(cuid())
  title      String
  notes      String?
  status     String    @default("TODO") // TODO | IN_PROGRESS | DONE
  priority   String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate    DateTime?
  isPrivate  Boolean   @default(false)
  teamId     String? // null = personal task
  leadId     String? // optional link: this task belongs to a pipeline contact
  creatorId  String
  assigneeId String?

  creator  User  @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team     Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lead     Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  comments TaskComment[]
  events   TaskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, status])
  @@index([teamId, status])
  @@index([leadId])
}

// Team discussion threads ON tasks — the in-context alternative to WhatsApp groups.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// Sealed accountability record for tasks. Append-only, hash-chained: every event
// seals the previous one (sha256), so editing or deleting a row breaks the chain
// and the task's history reads as tampered. Actor names are denormalised so the
// record survives members leaving. The team answer to "who dropped the ball".
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  seq       Int      // 1..n within the task; the chain walks in this order
  type      String   // CREATED | SENT | OPENED | STATUS | COMMENT | EDIT
  actorId   String?
  actorName String   // denormalised: the record survives member changes
  detail    String   // human line: "sent to Sipho", "opened it", "moved to Done"
  prevHash  String   @default("")
  hash      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, seq])
  @@index([taskId, type])
}

// ============ FINANCE ============

model FinanceEntry {
  id          String   @id @default(cuid())
  userId      String
  type        String // INCOME | EXPENSE
  description String
  category    String?
  amount      Float // positive rands
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([projectId])
}

// ============ APPOINTMENTS ============

model Appointment {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  title      String
  clientName String?
  notes      String?
  startsAt   DateTime
  endsAt     DateTime?
  meetLink   String? // Jitsi link (meet.ts)
  source     String    @default("MANUAL") // MANUAL | VOICE | ICS
  gcalEventId String?  // set when synced to Google Calendar
  externalId String?   // iCalendar UID or feed identity — the import/sync dedupe key
  icsFeed    Boolean   @default(false) // true when this row came from an ICS feed sync
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([projectId])
}

// ============ INVOICES ============

model Invoice {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  number      String    @unique
  clientName  String
  clientEmail String?
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE
  items       String    @default("[]") // JSON [{description, quantity, unitPrice}]
  currency    String    @default("ZAR")
  subtotal    Float     @default(0)
  taxRate     Float     @default(15)
  total       Float     @default(0)
  logoUrl     String?   // data URL for the printable template
  bankDetails String?   // banking details snapshot printed on the invoice (plain text lines)
  notes       String?
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([projectId])
}

// ============ EMAIL (user's own Gmail SMTP) ============

model EmailLog {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  leadId     String?
  toEmail    String
  subject    String
  body       String
  status     String    @default("DRAFT") // DRAFT | QUEUED | SENT | FAILED | BOUNCED | SKIPPED
  provider   String    @default("GMAIL")
  error      String?
  campaign   String? // bulk send grouping, e.g. blackbiz-intro
  providerId String? // provider message id — matches bounce/complaint webhooks back to this row
  openedAt   DateTime? // first open of the tracking pixel
  openCount  Int       @default(0)
  sentAt     DateTime? // the moment the engine actually sent (queued rows pace over hours)
  createdAt  DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([campaign])
  @@index([providerId])
}

// ============ SUPPRESSION (do-not-send list) ============

// Anyone who bounced hard, complained, or unsubscribed never gets another
// campaign email. This list is law for the queue engine — it is checked
// before every send, no exceptions.
model Suppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   // BOUNCE | COMPLAINT | UNSUB | MANUAL
  note      String? // e.g. the campaign that produced the bounce
  createdAt DateTime @default(now())
}

// ============ WHATSAPP (Cloud API log: inbound auto-capture + outbound sends) ============

model WaMessage {
  id          String   @id @default(cuid())
  userId      String
  clientId    String?
  phone       String   // E.164 without + (WhatsApp wa_id)
  direction   String   // IN | OUT
  body        String
  status      String   @default("RECEIVED") // RECEIVED | SENT | FAILED
  waMessageId String?  // Meta wamid for dedup/status
  error       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, phone])
}

// ============ USER INTEGRATION SETTINGS ============

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String // GMAIL_USER | GMAIL_APP_PASSWORD | GEMINI_API_KEY | EXPLEE_API_KEY ...
  value     String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ============ WALLET / CREDITS ============

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // cents (R1 = 100)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTx {
  id           String   @id @default(cuid())
  userId       String
  type         String // TOPUP | LEAD_REVEAL | BONUS | ADJUSTMENT
  amount       Int // cents, negative = spend
  description  String
  balanceAfter Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TopUp {
  id          String   @id @default(cuid())
  userId      String
  packageId   String
  amountCents Int // what user pays
  creditCents Int // credits received
  status      String   @default("PENDING") // PENDING | PAID | FAILED
  provider    String   @default("YOCO")
  reference   String
  providerRef String? // Yoco checkout/payment id for reconciliation
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ AI ============

model AiPlan {
  id        String   @id @default(cuid())
  userId    String
  answers   String // JSON of wizard answers
  content   String // markdown plan
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============ GAMIFICATION ============

model XpEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String // LEAD_ADDED | TASK_DONE | LEAD_REVEALED | DAILY_LOGIN | AI_PLAN ...
  amount      Int
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ChallengeProgress {
  id     String  @id @default(cuid())
  userId String
  day    String // YYYY-MM-DD
  key    String
  count  Int     @default(0)
  done   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, key])
}

// ============ PLATFORM CONFIG (admin) ============

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============ SUBSCRIPTIONS (predictable MRR) ============

model Subscription {
  id           String    @id @default(cuid())
  userId       String    @unique // one plan per user (upsert on renewal/upgrade)
  plan         String    // HUSTLER | BOSS
  status       String    @default("PENDING") // PENDING | ACTIVE | PAUSED | PAST_DUE | CANCELED
  billingCycle String    @default("MONTHLY") // MONTHLY | ANNUAL (annual = 2 months free)
  amountCents  Int
  provider     String    @default("YOCO")
  reference    String    // platform reference (HPSUB-...)
  providerRef  String?   // Yoco checkout/payment id for reconciliation
  npoNumber    String?   // registered nonprofit number: 30% off while it stands
  pausedUntil  DateTime? // while PAUSED: plan is frozen; auto-resumes with zero lost days
  startedAt    DateTime?
  renewsAt     DateTime? // monthly (+35d grace) or annual (+370d grace) anniversary
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, renewsAt])
}

// ============ REFERRALS (distribution + reverse churn) ============

model Referral {
  id            String    @id @default(cuid())
  referrerId    String    // who shared their code
  invitedUserId String?   // set when the invited person registers
  invitedEmail  String?
  status        String    @default("SIGNED_UP") // SIGNED_UP | SUBSCRIBED
  rewardCents   Int       @default(0) // total credited to referrer
  createdAt     DateTime  @default(now())
  subscribedAt  DateTime?

  referrer    User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  invitedUser User?  @relation("Invitee", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([invitedUserId])
}

// ============ INVENTORY (stock management) ============

model InventoryItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  sku         String?  // stock code / barcode
  quantity    Float    @default(0)
  unit        String?  // "units", "kg", "litres"…
  costPrice   Float    @default(0) // rands per unit
  sellPrice   Float    @default(0) // rands per unit
  lowStockAt  Float    @default(0) // alert when quantity <= this
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ PUSH NOTIFICATIONS (installed PWA) ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique // push service URL — one row per device
  p256dh    String   // subscription keys
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ VERIFIED LEAD POOL (shared freshness + scale layer) ============

// One row per REAL business ever surfaced by any scan on the platform,
// deduplicated by fingerprint. Every later scan that sees the same business
// again bumps lastSeenAt and confirmCount — that is the "still active" signal.
// Serving rotates the least recently served faces first, so repeated scans
// show each seller businesses they have never saved before. Pool first
// serving keeps engine quota spend flat as the user base grows: the first
// scan of a topic pays, everyone after serves free.
model LeadPool {
  id             String    @id @default(cuid())
  fingerprint    String    @unique // normKey(company) + "|" + normKey(city or area)
  company        String
  industry       String?
  city           String?
  areaLabel      String?   // the human area line of the scans that found it
  address        String?
  phone          String?   // normalized +27 form
  phoneRaw       String?   // as first seen
  email          String?
  website        String?
  contactName    String?
  role           String?   // the human's part: Owner, Manager, Buyer
  profileUrl     String?   // public profile page where this person is named
  why            String?   // last fit line from ranking
  score          Int?      // last AI fit score 1..5
  lat            Float?
  lng            Float?
  source         String    // GEMINI | ZAI | OSM | EXPLEE
  poolTag        String?   // the outreach project this verified contact came from
  sourceRef      String?   // OSM node/way link or directory url
  confirmCount   Int       @default(1)
  verifyScore    Int       @default(0) // 0..100
  verifyState    String    @default("new") // new | active | listed | stale
  verifyChecks   String?   // JSON { phoneOk, websiteOk, checkedAt }
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastVerifiedAt DateTime?
  timesServed    Int       @default(0)
  lastServedAt   DateTime?
  active         Boolean   @default(true)

  hits LeadPoolHit[]

  @@index([lastSeenAt])
  @@index([lastServedAt])
  @@index([lastVerifiedAt])
  @@index([city])
}

// Links a scan topic (normalized description + area) to the pool records it
// surfaced. The same topic asked again by ANY seller serves from here
// instantly, without touching the engines.
model LeadPoolHit {
  id        String   @id @default(cuid())
  topicFp   String
  poolId    String
  createdAt DateTime @default(now())

  pool LeadPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([topicFp, poolId])
  @@index([topicFp])
}

// One row per scan. Doubles as the rate limit anchor (cooldown between scans
// + daily allowance per user) and the warm pool window (a topic scanned
// moments ago by anyone serves while it warms).
model ScanRun {
  id        String   @id @default(cuid())
  userId    String
  topicFp   String
  mode      String   // POOL | WARM | AI_SEARCH | OSM | EXPLEE | NONE
  leadCount Int      @default(0)
  fromPool  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([topicFp, createdAt])
}

// ============ EXEC LEAD POOL (per client, the owner's review bench) ============
// When a client loads credit, a lead campaign runs for them automatically
// (Explee first, the platform's verified pool as the free fallback). Every
// campaign's results land HERE, one bench per client, waiting for the business
// owner's review. Nothing enters the client's pipeline until the owner taps
// Add — they stay the gatekeeper of what their clients see.
model ClientPoolLead {
  id          String    @id @default(cuid())
  userId      String // the platform client (seller) this bench belongs to
  fingerprint String // normKey(company) + "|" + normKey(city) — dedup inside this bench
  company     String
  contactName String?
  role        String? // the human's part: Owner, Manager, Buyer
  profileUrl  String? // public profile page where this person is named
  email       String?
  phone       String?
  website     String?
  industry    String?
  city        String?
  country     String?
  source      String    @default("EXPLEE") // EXPLEE | POOL | MANUAL
  sourceRef   String? // Explee domain/linkedin url or pool source link
  why         String? // fit line for the owner's quick read
  score       Int?
  status      String    @default("NEW") // NEW | ADDED | DISMISSED
  leadId      String? // set the moment the lead joins the client's pipeline
  createdAt   DateTime  @default(now())
  addedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@index([createdAt])
}

// Daily AI usage counter — the cost guard for the Gemini/DeepSeek generation
// surfaces. One row per user per SAST day; the route checks the cap BEFORE the
// spend, the increment is atomic (upsert), so parallel calls cannot sneak past.
model AiUsage {
  id     String @id @default(cuid())
  userId String
  day    String // SAST day stamp, e.g. "2026-10-16"
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

// ============ POPIA LISTING SUPPRESSION ============

// A business that asked to stay out of the lead index ("remove my listing").
// Suppressed names stop flowing through scan ingestion, the verified pool
// and the paid reveal. Matching is by normalised name + city, or by the
// exact map listing id when the request names one. Deliberately broad: an
// opt-out must never leak through a fingerprint variation.
model ListingSuppression {
  id        String   @id @default(cuid())
  name      String   // business name as submitted
  nameKey   String   // normalised name — the matching key
  city      String   @default("") // normalised city, empty = none given
  osmId     String?  // external map listing id when known
  contact   String?  // requester email or phone (for confirming the request)
  reason    String?
  source    String   @default("WEB") // WEB | EXEC
  createdAt DateTime @default(now())

  @@unique([nameKey, city])
  @@index([osmId])
}
