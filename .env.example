# Postgres (production — Vercel Postgres / Neon / Supabase)
# Pooled URL for the app runtime; for `prisma db push` use the DIRECT (non-pooler) URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Yoco payments (Checkout API) — https://developer.yoco.com/docs/checkout-api
# Server-side secret key from the Yoco app: Checkout API integration -> How to connect.
# Test key (sk_test_...) works immediately; live key unlocks after domain verification.
YOCO_SECRET_KEY="sk_test_xxx"
# Webhook signing secret (whsec_...) — auto-stored in DB by POST /api/webhooks/yoco/register,
# or set here manually to override:
YOCO_WEBHOOK_SECRET="whsec_xxx"

# treg.to team token — Door 3c mailbox verification (https://treg.to). Without it the reveal behaves exactly as before (fail-open).
TREG_TOKEN=

# PostHog product analytics (Task 167) — https://posthog.com
# Create a project (EU / Frankfurt region recommended for the POPIA posture),
# then set the Project API key + ingestion host and redeploy. With these unset
# the whole thing stays dark: no script loads, /ingest answers 404.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Inbound mail capture (CC/BCC to log@hustleportal.online, Task 199) — the
# secret the SES receipt-rule SNS subscription carries on its webhook URL.
# Falls back to SES_WEBHOOK_SECRET when unset. Never set = the door 503s.
SES_INBOUND_SECRET=
